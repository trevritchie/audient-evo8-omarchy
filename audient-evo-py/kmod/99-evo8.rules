# Allow local users to access /dev/evo8 and its USB device node immediately without relogin
SUBSYSTEM=="usb", ATTR{idVendor}=="2708", ATTR{idProduct}=="0007", MODE="0666", TAG+="uaccess"
KERNEL=="evo8", SUBSYSTEM=="misc", MODE="0666", TAG+="uaccess", \
  TAG+="systemd", ENV{SYSTEMD_USER_WANTS}="evo8-load-config.service"
