{
  // Hardware Audio DSP Controls
  "trigger.dsp": {
    "icon": "󰓃",
    "label": "DSP",
    "aliases": ["dsp", "dolby", "equalizer", "audio-profile", "thinkpad-audio", "audio-dsp"],
    "description": "Hardware audio DSP profiles"
  },
  "trigger.dsp.status": {
    "icon": "󰋋",
    "label": "Headphones / External Active",
    "description": "Speaker DSP is automatically bypassed",
    "when": "! thinkpad-dolby is-speaker"
  },
  "trigger.dsp.balanced": {
    "icon": "",
    "label": "Dolby Balanced",
    "description": "Default balanced soundstage",
    "when": "thinkpad-dolby is-speaker",
    "checked": "[[ \"$(thinkpad-dolby current)\" == \"Dolby-Balanced\" ]]",
    "action": "thinkpad-dolby balanced"
  },
  "trigger.dsp.detailed": {
    "icon": "",
    "label": "Dolby Detailed",
    "description": "Crisp treble & clear vocals (cold/bright)",
    "when": "thinkpad-dolby is-speaker",
    "checked": "[[ \"$(thinkpad-dolby current)\" == \"Dolby-Detailed\" ]]",
    "action": "thinkpad-dolby detailed"
  },
  "trigger.dsp.warm": {
    "icon": "",
    "label": "Dolby Warm",
    "description": "Rich low-mids & relaxed tone (warm/fire)",
    "when": "thinkpad-dolby is-speaker",
    "checked": "[[ \"$(thinkpad-dolby current)\" == \"Dolby-Warm\" ]]",
    "action": "thinkpad-dolby warm"
  },
  "trigger.dsp.off": {
    "icon": "󰖁",
    "label": "True Bypass",
    "description": "Raw uncorrected audio",
    "checked": "[[ \"$(thinkpad-dolby current)\" == \"off\" ]]",
    "action": "thinkpad-dolby off"
  },

  // Audient EVO 8 Audio Interface Controls
  "trigger.evo8": {
    "icon": "󰤽",
    "label": "Audient EVO 8",
    "aliases": ["evo8", "audient", "guitar", "xlr", "buffer", "samplerate", "loopback", "interface"],
    "description": "Hardware mixer, direct monitoring, buffer size & sample rate"
  },
  "trigger.evo8.tui": {
    "icon": "󰓃",
    "label": "Open EVO 8 Hardware Mixer (TUI)",
    "aliases": ["evotui", "evo8 mixer"],
    "description": "Full 10x4 hardware matrix mixer, preamps, 48V, pan & routing",
    "action": "~/.local/bin/evo8-audio tui"
  },
  "trigger.evo8.monitor1": {
    "icon": "󰍬",
    "label": "Direct Monitor In 1 (Guitar / Mic 1)",
    "aliases": ["guitar monitor", "direct monitor 1"],
    "description": "Toggle zero-latency hardware monitoring for Input 1",
    "action": "~/.local/bin/evo8-audio monitor 1 toggle"
  },
  "trigger.evo8.monitor2": {
    "icon": "󰍬",
    "label": "Direct Monitor In 2 (Mic 2)",
    "aliases": ["direct monitor 2"],
    "description": "Toggle zero-latency hardware monitoring for Input 2",
    "action": "~/.local/bin/evo8-audio monitor 2 toggle"
  },
  "trigger.evo8.monitor3": {
    "icon": "󰍬",
    "label": "Direct Monitor In 3 (Mic 3)",
    "aliases": ["direct monitor 3"],
    "description": "Toggle zero-latency hardware monitoring for Input 3",
    "action": "~/.local/bin/evo8-audio monitor 3 toggle"
  },
  "trigger.evo8.monitor4": {
    "icon": "󰍬",
    "label": "Direct Monitor In 4 (Mic 4)",
    "aliases": ["direct monitor 4"],
    "description": "Toggle zero-latency hardware monitoring for Input 4",
    "action": "~/.local/bin/evo8-audio monitor 4 toggle"
  },
  "trigger.evo8.loopback_main": {
    "icon": "󰋋",
    "label": "Loopback Source: Main 1+2 (YouTube / Headphones)",
    "aliases": ["loopback main", "record youtube", "record headphones", "evo8 loopback"],
    "description": "Record whatever plays out of Main Output 1+2 into EVO8 Loopback",
    "action": "~/.local/bin/evo8-audio loopback main"
  },
  "trigger.evo8.loopback_out34": {
    "icon": "󰑖",
    "label": "Loopback Source: Line Output 3+4",
    "aliases": ["loopback 3+4", "loopback out34"],
    "description": "Record playback sent to Line Output 3+4 into EVO8 Loopback",
    "action": "~/.local/bin/evo8-audio loopback out3_4"
  },
  "trigger.evo8.loopback_send56": {
    "icon": "󰑖",
    "label": "Loopback Source: Dedicated Send 5+6",
    "aliases": ["loopback send", "loopback 5+6"],
    "description": "Record only apps routed to EVO8 Loopback Output 5+6",
    "action": "~/.local/bin/evo8-audio loopback send5_6"
  },
  "trigger.evo8.loopback_hwmix": {
    "icon": "󰓃",
    "label": "Loopback Source: Hardware Mix (Mics + PC)",
    "aliases": ["loopback hwmix", "loopback master mix"],
    "description": "Record EVO 8 internal MU60 hardware mixer (Mics 1-4 + PC)",
    "action": "~/.local/bin/evo8-audio loopback hwmix"
  },
  "trigger.evo8.loopback_off": {
    "icon": "󰖁",
    "label": "Loopback Source: Off (Muted)",
    "aliases": ["loopback off", "mute loopback"],
    "description": "Mute EVO8 Loopback capture input",
    "action": "~/.local/bin/evo8-audio loopback off"
  },
  "trigger.evo8.buffer64": {
    "icon": "󰓅",
    "label": "Buffer: 64 samples (1.3 ms)",
    "aliases": ["buffer 64", "quantum 64"],
    "description": "Ultra-low latency for live guitar/amp sims",
    "action": "~/.local/bin/evo8-audio buffer 64"
  },
  "trigger.evo8.buffer128": {
    "icon": "󰓅",
    "label": "Buffer: 128 samples (2.7 ms)",
    "aliases": ["buffer 128", "quantum 128"],
    "description": "Low latency recording & monitoring",
    "action": "~/.local/bin/evo8-audio buffer 128"
  },
  "trigger.evo8.buffer256": {
    "icon": "󰓅",
    "label": "Buffer: 256 samples (5.3 ms)",
    "aliases": ["buffer 256", "quantum 256"],
    "description": "Balanced mixing & recording",
    "action": "~/.local/bin/evo8-audio buffer 256"
  },
  "trigger.evo8.buffer512": {
    "icon": "󰓅",
    "label": "Buffer: 512 samples (10.7 ms)",
    "aliases": ["buffer 512", "quantum 512"],
    "description": "Safe buffer for heavy project mixing",
    "action": "~/.local/bin/evo8-audio buffer 512"
  },
  "trigger.evo8.buffer1024": {
    "icon": "󰓅",
    "label": "Buffer: 1024 samples / Auto (21.3 ms)",
    "aliases": ["buffer auto", "buffer 1024"],
    "description": "Default dynamic desktop buffer",
    "action": "~/.local/bin/evo8-audio buffer auto"
  },
  "trigger.evo8.rate44100": {
    "icon": "󰤽",
    "label": "Sample Rate: 44.1 kHz",
    "aliases": ["44.1khz", "44100"],
    "description": "Force PipeWire & EVO 8 clock to 44,100 Hz",
    "action": "~/.local/bin/evo8-audio rate 44100"
  },
  "trigger.evo8.rate48000": {
    "icon": "󰤽",
    "label": "Sample Rate: 48 kHz (Default)",
    "aliases": ["48khz", "48000"],
    "description": "Reset PipeWire & EVO 8 clock to 48,000 Hz",
    "action": "~/.local/bin/evo8-audio rate 48000"
  },
  "trigger.evo8.rate88200": {
    "icon": "󰤽",
    "label": "Sample Rate: 88.2 kHz",
    "aliases": ["88.2khz", "88200"],
    "description": "Force PipeWire & EVO 8 clock to 88,200 Hz",
    "action": "~/.local/bin/evo8-audio rate 88200"
  },
  "trigger.evo8.rate96000": {
    "icon": "󰤽",
    "label": "Sample Rate: 96 kHz",
    "aliases": ["96khz", "96000"],
    "description": "Force PipeWire & EVO 8 clock to 96,000 Hz",
    "action": "~/.local/bin/evo8-audio rate 96000"
  }
}
